# Secrets and student data. The repository is public: the real passwords, the answer key, and
# the instructor password stay on the instructor's computer (and in the Cloudflare deployment).
.secret_key
instructor_password.txt
passwords.json
ANSWER_KEY.md
logs/

# Generated by cloudflare/build.py (levels.json contains the passwords)
cloudflare/dist/
cloudflare/src/levels.json
cloudflare/src/answer-key.json

# Roslindale trial fonts: licensed for testing only, so not redistributed here (see static/fonts/README.txt)
static/fonts/*.woff2

# Tools
cloudflare/node_modules/
cloudflare/.wrangler/
__pycache__/
.DS_Store
cloudflare/autodeploy.log
cloudflare/.last-deploy
